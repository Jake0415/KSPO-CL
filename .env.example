APP_ENV=local
TIMEZONE=Asia/Seoul
ADMIN_USERNAME=admin
ADMIN_PASSWORD_BCRYPT=generate-a-local-secret
SESSION_SECRET=generate-a-local-secret
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kspo_ingest_local
POSTGRES_USER=kspo
POSTGRES_PASSWORD=generate-a-local-secret
REDIS_URL=redis://redis:6379/0
