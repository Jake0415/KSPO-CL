QDRANT_INDEX_NAME=kspo_local
QDRANT_KNOWLEDGE_COLLECTION=kspo_local_knowledge
QDRANT_ARCHIVE_COLLECTION=kspo_local_archive
QDRANT_VECTOR_NAME=
KB_BOOTSTRAP=managed
KB_NAMESPACE=kspo-local
STORAGE_ROOT=/data
OPENAI_API_KEY=
OPENAI_REFINE_MODEL=gpt-5.4-mini
OPENAI_EMBED_MODEL=text-embedding-3-large
LLM_PROVIDER=openai
SONAR_BASE_URL=
