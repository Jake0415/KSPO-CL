SONAR_EMAIL=
SONAR_PASSWORD=
CRAWL_DYNAMIC_MAX_ACTIONS=100
CRAWL_RENDER_ALL_HTML=true
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres,redis,qdrant,api,web,host.docker.internal
